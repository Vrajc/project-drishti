# ==============================================
# DRISHTI - Docker Compose Environment Variables
# ==============================================

# PostgreSQL Configuration
POSTGRES_USER=drishti
POSTGRES_PASSWORD=drishti_secure_password_2024
POSTGRES_DB=drishti_db
POSTGRES_PORT=5432

# Prisma Studio Configuration
PRISMA_STUDIO_PORT=5555

# Redis Configuration (Optional)
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

# Database URL for Prisma (used by backend)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ==============================================
# MediaMTX - live stream layer (Phase 2)
# ==============================================
# Pin a release here if you need reproducibility; the default tracks latest.
MEDIAMTX_VERSION=latest

MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_UDP_PORT=8189
MEDIAMTX_API_PORT=9997

# ==============================================
# AI ANALYTICS SERVICE (Phase 3)
# ==============================================
AI_SERVICE_PORT=8100

# yolov8n.pt is the default because fifty concurrent streams on one machine is
# the constraint that matters. yolov8s.pt is more accurate and slower.
YOLO_MODEL=yolov8n.pt
YOLO_DEVICE=cpu

# Every Nth frame is inferred on; the rest are decoded and discarded.
FRAME_STRIDE=3

# Path to a licence-plate detector, inside the container. Leave empty and plate
# reading stays off: attributes.plateText is null on every vehicle, and /health
# says why. It is never guessed from a crop of the car.
PLATE_MODEL_PATH=
