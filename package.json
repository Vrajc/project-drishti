{
  "name": "drishti-event-safety-monorepo",
  "version": "1.0.0",
  "description": "Drishti Event Safety Platform - Full Stack Application",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ..",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start:backend": "cd backend && npm start",
    "verify": "npm run typecheck && npm run check:no-mocks",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "cd backend && npx tsc --noEmit",
    "typecheck:frontend": "cd frontend && npx tsc --noEmit",
    "check:no-mocks": "node scripts/run-sh.mjs scripts/check-no-mocks.sh",
    "streams:generate": "node scripts/generate-streams.js",
    "clean": "rimraf frontend/node_modules frontend/dist backend/node_modules backend/dist"
  },
  "keywords": [
    "event-safety",
    "full-stack",
    "react",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^6.19.3",
    "rimraf": "^5.0.5"
  },
  "type": "module"
}
