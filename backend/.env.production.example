# =============================================================================
# Backend environment - PRODUCTION (Render)
#
# .env.example documents every variable the code reads and is tuned for a local
# machine running the full docker-compose stack. This file is the subset that a
# hosted deployment actually needs, with the values that are correct when the
# camera stack is NOT hosted alongside it.
#
# Anything omitted here has a working default. Do not copy a variable across
# from .env.example without reading its note below: several of the local
# defaults (localhost Redis, localhost MediaMTX) are wrong in a deployment and
# are better left unset than set to a host that will never answer.
# =============================================================================

# --- Required ----------------------------------------------------------------

NODE_ENV=production

# Render supplies PORT. Leave it unset unless you have a reason not to.
# PORT=

# Prisma Postgres. The server exits at boot if this is missing in production
# rather than starting up and failing every request.
DATABASE_URL=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require

# Signs and verifies every session token. The server refuses to start in
# production without it: the code's development fallback is a literal in this
# public repository, and anyone could forge an admin or police token with it.
# Generate one with:  openssl rand -hex 32
# Changing it later logs everyone out, which is the intended behaviour.
JWT_SECRET=

# CORS. This must be the exact scheme and host the browser sends, with no
# trailing slash: an origin that is not on the allow-list is rejected, and in
# production there is no development bypass. Only one origin is read, so a
# preview deployment on a different Vercel URL will not be allowed through.
FRONTEND_URL=https://project-drishti-seven.vercel.app

# Google Gemini. Without it the AI endpoints fail; the post-event report then
# prints "analysis was unavailable" rather than inventing recommendations.
GEMINI_API_KEY=

# --- Demo accounts -----------------------------------------------------------

# The boot seed creates test@gmail.com (organizer) and police@gmail.com (police)
# so every role can be signed into. The police account reaches the surveillance
# estate, the watchlist and dispatch, and the repository's password is public -
# so in production the seed does nothing unless you ask for it here.
#
# Set both, or neither. SEED_DEMO_USERS=true without a password is refused.
# The seed only creates accounts that are missing; it never rewrites the
# password on one that already exists.
# SEED_DEMO_USERS=true
# SEED_USER_PASSWORD=

# --- Camera stack: leave unset unless it is actually hosted -------------------

# The ai-service this deployment drives. Unset means no detector: every screen
# that reports counts says so rather than showing an estate with nobody in it.
# AI_SERVICE_URL=

# Redis carries the ai-service's detection stream. When it is unset in
# production the detection consumer and the watchlist match engine stand down
# at boot with a log line, instead of reconnecting to a localhost Redis that
# does not exist for the life of the process. Set it only once Redis is real.
# REDIS_URL=

# MediaMTX republishes camera RTSP for the browser. With these unset the API
# tells the live wall that no playable URL exists, which is the truth, rather
# than composing a localhost URL that every viewer would fail to load.
# MEDIAMTX_RTSP_BASE=
# MEDIAMTX_HLS_BASE=
# MEDIAMTX_WEBRTC_BASE=

# Encrypts camera stream passwords at rest (AES-256-GCM). 64 hex chars:
#   openssl rand -hex 32
# Without it the API refuses to store a camera password rather than writing it
# in plaintext - cameras can still be registered, just without credentials.
# Set this before anyone registers a real camera, and never rotate it without
# re-encrypting: existing rows become undecryptable.
# CAMERA_CREDENTIAL_KEY=

# The health poller probes every registered camera on an interval. It is
# harmless while the estate is empty (nothing to probe), and stays on by
# default so it cannot be forgotten. Set false only if you seed cameras that
# are unreachable from the deployment and want the log quiet.
# CAMERA_HEALTH_ENABLED=false

# --- Optional tuning ---------------------------------------------------------
# Anomaly thresholds, detection sampling intervals and plate-match distance all
# have documented defaults in .env.example. Copy one across only when you want
# a value different from the default; each is read at call time, so a change
# takes effect on the next evaluation without a rebuild.
