# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL=postgresql://drishti:drishti_secure_password_2024@localhost:5432/drishti_db?schema=public

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# API Keys
# Google Gemini API Key (FREE - No credit card required)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Other API keys
# MAPS_API_KEY=your_maps_api_key_here

# Redis Configuration (Optional)
REDIS_URL=redis://:redis_secure_password@localhost:6379
