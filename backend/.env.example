# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (Prisma Postgres)
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# API Keys
# Google Gemini API Key (FREE - No credit card required)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Other API keys
# MAPS_API_KEY=your_maps_api_key_here

# Redis Configuration (Optional)
REDIS_URL=redis://:redis_secure_password@localhost:6379

# ==============================================
# SURVEILLANCE / CAMERA REGISTRY (Phase 1)
# ==============================================

# Base RTSP URL of the stream server the registry points cameras at. The camera
# seed builds each rtspUrl as <base>/camNN, so pointing this at a different host
# re-targets the whole estate without a code change.
# In docker compose this is the MediaMTX service: rtsp://mediamtx:8554
MEDIAMTX_RTSP_BASE=rtsp://localhost:8554

# 32-byte key used to encrypt camera stream passwords at rest (AES-256-GCM).
# Accepts 64 hex characters or base64. Generate one with:  openssl rand -hex 32
# If this is unset the API refuses to store a camera password rather than
# writing it in plaintext, so cameras can still be registered without one.
CAMERA_CREDENTIAL_KEY=

# Where MediaMTX republishes each RTSP path for the browser. A camera is only
# offered an HLS/WebRTC URL when its rtspUrl points at MEDIAMTX_RTSP_BASE above;
# for any other host the API says so rather than composing a URL that would 404.
MEDIAMTX_HLS_BASE=http://localhost:8888
MEDIAMTX_WEBRTC_BASE=http://localhost:8889

# ==============================================
# CAMERA HEALTH POLLER (Phase 2)
# ==============================================
# The only thing allowed to move a camera to ONLINE. It opens a socket and
# speaks RTSP (OPTIONS then DESCRIBE) or HTTP; it does not decode video, so
# CameraHealth.fpsObserved stays null until the stream workers fill it.

# Set to false to stop probing entirely. Cameras then keep whatever status they
# last had, which goes stale - prefer leaving it on.
CAMERA_HEALTH_ENABLED=true

# How often a full sweep runs.
CAMERA_HEALTH_POLL_SECONDS=30

# Per-camera probe timeout. A camera that has not answered by now is OFFLINE.
CAMERA_HEALTH_TIMEOUT_MS=5000

# Probes in flight at once. The whole sweep must finish inside the poll interval.
CAMERA_HEALTH_CONCURRENCY=12

# One CameraHealth row per camera per sweep adds up; older rows are pruned.
CAMERA_HEALTH_RETENTION_HOURS=24
