// Prisma Schema for Drishti Event Management System
// PostgreSQL Database with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL
// ============================================
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  role         UserRole @default(PARTICIPANT)
  organization String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  acknowledgedAlerts     Alert[]              @relation("AcknowledgedAlerts")
  issuedWatchlistEntries WatchlistEntry[]     @relation("IssuedWatchlistEntries")
  organizedEvents        Event[]              @relation("OrganizedEvents")
  registeredEvents       EventRegistration[]
  reportedIncidents      Incident[]
  // Dispatches this user ordered. Police and admin are the only roles the
  // dispatch routes admit, so in practice this is a police operator's log.
  dispatches             DispatchAssignment[] @relation("DispatchedBy")

  @@index([email])
  @@index([role])
  @@map("users")
}

enum UserRole {
  ORGANIZER
  PARTICIPANT
  ADMIN
  POLICE
}

// ============================================
// EVENT MODEL
// ============================================
model Event {
  id             String   @id @default(uuid())
  name           String
  type           String
  date           String
  time           String
  crowdSize      Int
  location       String
  description    String?
  mapFile        String? // Base64 encoded map image
  image          String?
  organizerId    String
  organizerEmail String
  organizerName  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organizer      User                @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  zones          Zone[]
  cameras        Camera[]
  dispatchUnits  DispatchUnit[]
  registrations  EventRegistration[]
  incidents      Incident[]
  crowdDensities CrowdDensity[]

  @@index([organizerId])
  @@index([date])
  @@index([type])
  @@map("events")
}

// ============================================
// ZONE MODEL (Sub-entity of Event)
// ============================================
// A zone is a counting region. It belongs to an event (the organizer's layout)
// or to a registry camera (a standing region of interest on the estate, which
// is what lets police crowd analytics exist without an event). Exactly one of
// `eventId` / `cameraId` is set — enforced by zones_scope_check in the
// add_police_operations migration.
model Zone {
  id          String   @id @default(uuid())
  eventId     String?
  cameraId    String?
  zoneId      String // Custom zone identifier
  name        String
  coordinates Json // Array of {x, y} coordinates
  maxCapacity Int
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  event          Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  camera         Camera?        @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  crowdDensities CrowdDensity[]

  // Guards event zones only: Postgres treats NULLs as distinct, so two camera
  // zones could both claim the same zoneId. zones_camera_zoneId_key, a partial
  // unique index in the migration, closes that the way Phase 1 did for cameras.
  @@unique([eventId, zoneId])
  @@index([eventId])
  @@index([cameraId])
  @@map("zones")
}

// ============================================
// CAMERA MODEL (standalone registry; optionally attached to an Event)
// ============================================
// A camera exists in the registry whether or not an event is using it, so
// `eventId` is nullable. `@@unique([eventId, cameraId])` still guards cameras
// attached to an event; Postgres treats NULLs as distinct, so registry-only
// cameras are guarded instead by a partial unique index created in the
// add_camera_registry migration (cameras_registry_cameraId_key).
model Camera {
  id        String  @id @default(uuid())
  eventId   String?
  cameraId  String // Custom camera identifier, e.g. "GNR-SEC-014"
  name      String
  location  String
  ipAddress String
  rtspUrl   String

  // --- GIS ---
  // WGS84. Null means the camera has been registered but not yet surveyed;
  // the map lists those separately rather than dropping a pin at 0,0.
  latitude       Float?
  longitude      Float?
  // Compass bearing the lens faces, 0-360 degrees clockwise from north.
  coverageAngle  Float?
  // Effective viewing range in metres, as declared by the installer.
  coverageRadius Float?
  isPtz          Boolean @default(false)

  // --- Hardware and connection, as declared in the deployment inventory ---
  vendor      String?
  model       String?
  protocol    String? // RTSP | ONVIF | HTTP
  onvifUrl    String?
  username    String?
  passwordEnc String? // Encrypted at rest; never returned by the API
  resolution  String? // Configured, e.g. "1920x1080"
  fps         Int? // Configured, not measured

  // --- Observed state ---
  // UNKNOWN until a health check actually reaches the stream. Nothing writes
  // ONLINE without a successful probe, and lastSeenAt stays null until then.
  status     CameraStatus @default(UNKNOWN)
  lastSeenAt DateTime?

  departmentId String?
  siteId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event          Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site           Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  crowdDensities CrowdDensity[]
  healthChecks   CameraHealth[]
  detections     Detection[]
  alerts         Alert[]
  trackPoints    TrackPoint[]
  zones          Zone[]
  incidents      Incident[]

  @@unique([eventId, cameraId])
  @@index([eventId])
  @@index([status])
  @@index([departmentId])
  @@index([siteId])
  @@map("cameras")
}

enum CameraStatus {
  ONLINE
  OFFLINE
  DEGRADED
  UNKNOWN
}

// ============================================
// DEPARTMENT MODEL (owner of a group of cameras)
// ============================================
model Department {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. "GNR-CITY"
  name         String
  contactName  String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sites         Site[]
  cameras       Camera[]
  dispatchUnits DispatchUnit[]

  @@map("departments")
}

// ============================================
// SITE MODEL (a physical location within a department)
// ============================================
model Site {
  id           String   @id @default(uuid())
  departmentId String?
  code         String   @unique
  name         String
  address      String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  cameras    Camera[]
  incidents  Incident[]

  @@index([departmentId])
  @@map("sites")
}

// ============================================
// CAMERA HEALTH MODEL (one row per reachability probe)
// ============================================
// Every row here is the result of an actual probe. `cameraId` is a foreign key
// to cameras.id (the UUID), NOT the human-facing Camera.cameraId string.
model CameraHealth {
  id          String       @id @default(uuid())
  cameraId    String
  checkedAt   DateTime     @default(now())
  status      CameraStatus
  latencyMs   Int? // Measured round trip, null if the probe never connected
  fpsObserved Float? // Measured, null until a decoder reports it
  error       String? // Verbatim failure reason when status is not ONLINE

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, checkedAt])
  @@index([checkedAt])
  @@map("camera_health")
}

// ============================================
// DISPATCH UNIT MODEL (Sub-entity of Event)
// ============================================
// A responder unit. Event units are the organizer's own marshals and medics;
// registry units (eventId null, departmentId set) are the standing estate
// resources a police operator dispatches. Same table, because dispatching is
// the same act either way and the console should not care which it is.
model DispatchUnit {
  id           String  @id @default(uuid())
  eventId      String?
  departmentId String?
  unitId       String // Custom unit identifier
  name         String
  type         String
  contact      String
  capacity     Int
  location     String

  // WGS84, and null until someone has actually surveyed the unit's base. The
  // nearest-unit computation skips units without a position rather than
  // guessing one - the same rule the camera map follows.
  latitude  Float?
  longitude Float?

  status DispatchUnitStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event       Event?               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  department  Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments DispatchAssignment[]

  // Event units only, for the same NULL-distinctness reason as Zone and Camera.
  // dispatch_units_registry_unitId_key covers registry units in the migration.
  @@unique([eventId, unitId])
  @@index([eventId])
  @@index([departmentId])
  @@index([status])
  @@map("dispatch_units")
}

enum DispatchUnitStatus {
  AVAILABLE
  DISPATCHED
  BUSY
  OFFLINE
}

// ============================================
// EVENT REGISTRATION MODEL (Many-to-Many)
// ============================================
model EventRegistration {
  id           String   @id @default(uuid())
  userId       String
  eventId      String
  registeredAt DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("event_registrations")
}

// ============================================
// INCIDENT MODEL
// ============================================
// An incident is raised either against an event (an organizer's marshal reports
// it) or against a registry camera (the estate raised it, with no event
// involved). At least one of `eventId` / `cameraId` is always set - enforced by
// incidents_scope_check in the add_police_operations migration - so nothing can
// land in the table with no jurisdiction at all.
model Incident {
  id       String  @id @default(uuid())
  eventId  String?
  cameraId String?
  siteId   String?

  type        IncidentType
  // Optional because most incidents are never assessed. The reporting UI does
  // not collect a severity, and the default that used to stand in for one -
  // MEDIUM - was read downstream as an assessment nobody made. Null means
  // exactly that: no one has classified this yet.
  severity    IncidentSeverity?
  source      IncidentSource   @default(MANUAL)
  description String
  location    String

  // A photo attached by the reporter, as a data URL. The report form has always
  // offered to attach one - for a lost child or a found bag it is most of the
  // report - and the client had nowhere to send it, so every photo a reporter
  // selected was discarded after the filename was shown back to them.
  // Stored inline like Event.mapFile: this deployment has no object store, and
  // a path to a file nothing writes would be worse than the bytes.
  photo       String?

  // Where it happened, when that is known. An incident on a surveyed camera
  // inherits the camera's position; a manual report from an organizer has none,
  // and gets null rather than the venue's centroid.
  latitude  Float?
  longitude Float?

  timestamp DateTime @default(now())

  // Null for SOURCE=ANOMALY: the rule engine raised it, and attributing a
  // machine-raised incident to a person would be a lie in the audit trail.
  reporter      String?
  reporterEmail String?

  status       IncidentStatus @default(OPEN)
  responseTime Int? // seconds from timestamp to resolvedAt, written only on a real resolution
  resolvedAt   DateTime?

  // Set only by the anomaly rule engine, and only to a value it computed. It is
  // the rule's own confidence (e.g. occupancy over capacity), never a range.
  detectionConfidence Float?
  // The rule that fired, e.g. "CAMERA_OFFLINE". Null for manual reports.
  ruleKey             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event        Event?               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  camera       Camera?              @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  site         Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  reporterUser User?                @relation(fields: [reporter], references: [id])
  assignments  DispatchAssignment[]

  @@index([eventId])
  @@index([eventId, status])
  @@index([eventId, timestamp])
  @@index([cameraId])
  @@index([cameraId, timestamp])
  @@index([status])
  @@index([status, severity])
  @@index([source, ruleKey, timestamp])
  @@map("incidents")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// How the incident came to exist. MANUAL is a human report; ANOMALY is the rule
// engine acting on measured data. Nothing else may write ANOMALY.
enum IncidentSource {
  MANUAL
  ANOMALY
}

// ============================================
// DISPATCH ASSIGNMENT MODEL
// ============================================
// The dispatch audit trail: who sent which unit to what, and what happened
// next. Every timestamp below is null until that thing actually happened, so
// "acknowledged in 40s" can only ever be read off a real acknowledgement.
model DispatchAssignment {
  id           String         @id @default(uuid())
  incidentId   String
  unitId       String
  dispatchedBy String // users.id of the operator who ordered it
  status       DispatchStatus @default(DISPATCHED)

  dispatchedAt   DateTime  @default(now())
  acknowledgedAt DateTime?
  arrivedAt      DateTime?
  clearedAt      DateTime?

  // Written only when a routing service actually answered, and left null
  // otherwise. The console renders null as "ETA unavailable" - it does not
  // estimate. `straightLineM` is a haversine on two stored coordinates, which
  // is a real measurement of a real distance, just not a road distance.
  etaSeconds     Int?
  routeDistanceM Float?
  straightLineM  Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incident   Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  unit       DispatchUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  dispatcher User         @relation("DispatchedBy", fields: [dispatchedBy], references: [id])

  @@index([incidentId])
  @@index([unitId])
  @@index([status])
  @@index([dispatchedAt])
  @@map("dispatch_assignments")
}

enum DispatchStatus {
  DISPATCHED
  ACKNOWLEDGED
  ARRIVED
  CLEARED
  CANCELLED
}

enum IncidentType {
  MEDICAL
  SECURITY
  LOST_FOUND
  GENERAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

// ============================================
// CROWD DENSITY MODEL
// ============================================
// A counted reading for one zone at one moment. `eventId` is null for readings
// taken on a registry camera's own zone, which is what makes crowd analytics
// available to police outside any event.
model CrowdDensity {
  id                String   @id @default(uuid())
  eventId           String?
  zoneId            String?
  zoneName          String
  peopleCount       Int
  densityPercentage Float
  timestamp         DateTime
  videoTimestamp    String // Format: HH:MM:SS
  cameraId          String?
  cameraName        String?

  // Metadata fields
  frameNumber    Int?
  confidence     Float?
  processingTime Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  camera Camera? @relation(fields: [cameraId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([zoneId])
  @@index([eventId, zoneId, timestamp])
  @@index([eventId, timestamp])
  @@index([timestamp])
  @@map("crowd_densities")
}

// ============================================
// ADDITIONAL UTILITY MODELS
// ============================================

// AI Summary/Analysis Cache
model AISummary {
  id          String   @id @default(uuid())
  entityType  String // 'event', 'incident', 'crowd_analysis'
  entityId    String
  summaryType String // 'general', 'risk', 'recommendation'
  content     String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("ai_summaries")
}

// System Logs for audit trail
model SystemLog {
  id          String   @id @default(uuid())
  action      String
  userId      String?
  eventId     String?
  description String   @db.Text
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([eventId])
  @@index([action])
  @@index([createdAt])
  @@map("system_logs")
}

// Notification table for real-time alerts
model Notification {
  id        String               @id @default(uuid())
  userId    String?
  eventId   String?
  type      NotificationType
  title     String
  message   String               @db.Text
  isRead    Boolean              @default(false)
  priority  NotificationPriority @default(NORMAL)
  metadata  Json?
  createdAt DateTime             @default(now())

  @@index([userId, isRead])
  @@index([eventId])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  INCIDENT
  CROWD_ALERT
  SYSTEM
  EVENT_UPDATE
  GENERAL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

// ============================================================================
// WATCHLIST, DETECTIONS AND ALERTS (Phase 5)
// ============================================================================

enum WatchlistEntityType {
  VEHICLE
  PERSON
}

/**
 * How a match was arrived at. Stored rather than inferred from the score,
 * because a caller must be able to tell an exact plate match from a fuzzy one
 * without reverse-engineering a threshold.
 */
enum MatchType {
  PLATE_EXACT
  PLATE_FUZZY
  FACE
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  DISPATCHED
  CLOSED
  FALSE_POSITIVE
}

model WatchlistEntry {
  id         String              @id @default(uuid())
  entityType WatchlistEntityType

  // --- Vehicle ---
  // The plate as it was entered, kept verbatim for display. `plateNormalised`
  // is what the match engine compares against: uppercase, punctuation stripped,
  // and the O/0 and I/1 confusions folded. Both are stored because showing an
  // operator a normalised plate they did not type would be its own small lie.
  plateNumber      String?
  plateNormalised  String?
  vehicleMakeModel String?
  color            String?

  // --- Person ---
  personName String?
  photoUrl   String?
  // Face embedding, for the pgvector matching that is deliberately out of scope
  // here. Null on every row until that exists; nothing reads it yet.
  embedding  Json?

  // --- Provenance. A watchlist entry is a legal act, so it records one. ---
  caseNumber String
  caseType   String
  severity   IncidentSeverity @default(MEDIUM)
  issuedBy   String
  issuedAt   DateTime         @default(now())
  expiresAt  DateTime?
  isActive   Boolean          @default(true)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issuer User?   @relation("IssuedWatchlistEntries", fields: [issuedBy], references: [id])
  alerts Alert[]

  // The match engine loads active entries by normalised plate on every
  // detection carrying a plate, so this index is on the hot path.
  @@index([plateNormalised])
  @@index([isActive, entityType])
  @@index([caseNumber])
  @@map("watchlist_entries")
}

/**
 * A persisted detection.
 * NOT a complete record of everything the detector saw, and must never be
 * presented as one. The ai-service samples several frames a second per camera;
 * storing every detection would be tens of millions of rows a day. What is kept
 * is: the first sighting of each track on each camera, a refresh every
 * DETECTION_PERSIST_INTERVAL_SECONDS while that track is still in view, and
 * every detection that carried a plate reading. The sampling rule is documented
 * on the search endpoint so a caller knows what "all detections" means.
 */
model Detection {
  id       String @id @default(uuid())
  cameraId String

  // Stable per camera between stream discontinuities. Null when the tracker had
  // not yet associated the box with a track.
  trackId         Int?
  // The tracker generation this trackId belongs to. Two detections with the same
  // trackId in different generations are not the same object - a reconnect reset
  // the tracker in between.
  trackGeneration Int  @default(0)

  objectClass String
  confidence  Float
  // [x, y, w, h] in the frame's own pixel coordinates.
  bbox        Json

  // Null unless a plate detector and OCR actually read one.
  plateNumber     String?
  plateNormalised String?
  plateConfidence Float?
  // Measured from the crop's pixels, null when it could not be determined.
  color           String?
  vehicleType     String?

  // Relative path, resolved by the client against its own snapshot mount.
  snapshotPath String?

  ts        DateTime
  createdAt DateTime @default(now())

  camera Camera  @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([cameraId, ts])
  @@index([plateNormalised])
  @@index([plateNumber])
  @@index([ts])
  @@index([objectClass, ts])
  @@map("detections")
}

/**
 * A watchlist hit.
 * `matchScore` is always computed - by the match engine, from the edit distance
 * between the normalised plates - and never assigned a plausible-looking value.
 * An alert always points at the Detection that caused it, so an operator can see
 * the frame rather than take the system's word for it.
 */
model Alert {
  id               String @id @default(uuid())
  watchlistEntryId String
  detectionId      String
  cameraId         String

  matchType  MatchType
  matchScore Float
  ts         DateTime

  status         AlertStatus @default(NEW)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watchlistEntry WatchlistEntry @relation(fields: [watchlistEntryId], references: [id], onDelete: Cascade)
  detection      Detection      @relation(fields: [detectionId], references: [id], onDelete: Cascade)
  camera         Camera         @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  acknowledger   User?          @relation("AcknowledgedAlerts", fields: [acknowledgedBy], references: [id])

  @@index([status, ts])
  @@index([watchlistEntryId, ts])
  @@index([cameraId, ts])
  @@index([ts])
  @@map("alerts")
}

/**
 * One position of one track at one moment, for cross-camera route history.
 * lat/lng are the CAMERA's surveyed position, not the object's - this system
 * cannot place an object within a camera's field of view. A route drawn from
 * these is a sequence of cameras that saw the vehicle, which is what it must be
 * labelled as. Rows only exist for cameras that have been surveyed.
 */
model TrackPoint {
  id       String @id @default(uuid())
  cameraId String

  trackId         Int
  trackGeneration Int @default(0)

  ts  DateTime
  lat Float
  lng Float

  plateNormalised String?
  plateNumber     String?
  objectClass     String?

  createdAt DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([plateNormalised, ts])
  @@index([cameraId, ts])
  @@index([trackId, cameraId, ts])
  @@index([ts])
  @@map("track_points")
}
